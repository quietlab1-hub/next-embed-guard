    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test .test-build/",
    "test:strip": "node --test --experimental-strip-types src/embed-guard.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "next": ">=13"
