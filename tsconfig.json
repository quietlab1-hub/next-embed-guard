{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true
  },
  // `examples/` imports `next/server`, which is a peer dependency and is not
  // installed here: it is typechecked inside a real Next.js app, not by this
  // config. See tsconfig.examples.json.
  "include": ["src"]
}
